NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Paid access disabled by default.
AI_ALLOW_PAID=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional server-only preview access token (at least 32 characters)
AI_PREVIEW_TOKEN=

# Separate admin token, at least 32 characters; never reuse preview token
AI_ADMIN_TOKEN=

# Future encrypted storage: random 32-byte key encoded as 64 hex characters
AI_KEY_ENCRYPTION_KEY=

AI_DATABASE_PROVIDERS=false
SUPABASE_SERVICE_ROLE_KEY=

# Exact model ID explicitly verified to support vision (optional)
OPENROUTER_VISION_MODEL=
GEMINI_VISION_MODEL=
OPENAI_VISION_MODEL=
GROQ_VISION_MODEL=
NVIDIA_VISION_MODEL=

AI_WEB_SEARCH=false
BRAVE_SEARCH_API_KEY=
